# MongoDB
MONGO_URI=mongodb+srv://...

# JWT (required — server refuses to start without this)
JWT_SECRET=change-me-to-a-long-random-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (free path)

# Resend (optional fallback if you still want it)
RESEND_API_KEY=re_...
RESEND_FROM=notifications@yourdomain.com
